{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homeserver Overlay",
  "version": "0.1.0",
  "identifier": "de.vincefidanli.homeserveroverlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Homeserver Overlay",
        "width": 210,
        "height": 122,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "terminal",
        "title": "Homeserver Shell",
        "url": "index.html?window=terminal",
        "width": 900,
        "height": 550,
        "minWidth": 500,
        "minHeight": 300,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExRUFBMzAyMkVCM0YyRTEKUldUaDhyTXVBcVBxRWIxcDFNV1FFMkxxeE5nelhyaTZoajZZWWxjZ0ZOcGMwaitSWWZvNDdzQWMK",
      "endpoints": [
        "https://github.com/Applejuicedev/homeserver-overlay/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
